<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" android:minSdkVersion="34" />
    <permission android:name="com.dark.tool_neuron.permission.BIND_LLM_SERVICE" android:protectionLevel="signature" />
    <application
        android:name=".NVApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/ic_ultra_agent"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@drawable/ic_ultra_agent"
        android:supportsRtl="true"
        android:theme="@style/Theme.NeuroVerse"
        tools:targetApi="34">
        <activity android:name=".activity.MainActivity" android:exported="true" android:launchMode="singleTask" android:theme="@style/Theme.NeuroVerse" android:windowSoftInputMode="adjustResize">
            <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter>
        </activity>
        <activity android:name=".activity.ModelLoadingActivity" android:exported="false" android:launchMode="singleTask" android:theme="@style/Theme.NeuroVerse" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".activity.ModelPickerActivity" android:exported="false" android:launchMode="singleTask" android:theme="@style/Theme.NeuroVerse" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".activity.RagActivity" android:exported="true" android:launchMode="singleTask" android:theme="@style/Theme.NeuroVerse" android:windowSoftInputMode="adjustResize">
            <intent-filter><action android:name="android.intent.action.VIEW" /><category android:name="android.intent.category.DEFAULT" /><category android:name="android.intent.category.BROWSABLE" /><data android:scheme="content" /><data android:host="*" /><data android:mimeType="*/*" /><data android:pathPattern=".*\\.rag" /><data android:pathPattern=".*\\.RAG" /></intent-filter>
        </activity>
        <activity android:name=".activity.RagDataReaderActivity" android:exported="false" android:theme="@style/Theme.NeuroVerse" android:windowSoftInputMode="adjustResize" />
        <service android:name=".service.LLMService" android:enabled="true" android:exported="true" android:foregroundServiceType="dataSync" android:permission="com.dark.tool_neuron.permission.BIND_LLM_SERVICE" android:stopWithTask="false" tools:targetApi="29" />
        <service android:name=".service.ModelDownloadService" android:enabled="true" android:exported="false" android:foregroundServiceType="dataSync" tools:targetApi="29" />
        <service android:name="androidx.work.impl.foreground.SystemForegroundService" android:foregroundServiceType="dataSync" tools:node="merge" tools:targetApi="29" />
        <service android:name=".ultra.accessibility.UltraAccessibilityService" android:description="@string/accessibility_service_description" android:exported="true" android:label="@string/app_name" android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter><action android:name="android.accessibilityservice.AccessibilityService" /></intent-filter>
            <meta-data android:name="android.accessibilityservice" android:resource="@xml/accessibility_config" />
        </service>
        <provider android:name="androidx.core.content.FileProvider" android:authorities="${applicationId}.fileprovider" android:exported="false" android:grantUriPermissions="true"><meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" /></provider>
    </application>
</manifest>